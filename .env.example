# Copy this file to server/.env and fill in your real values.
# (server/.env is gitignored — never commit real secrets.)

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/GREEN_HUB
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Admin seed account (used by npm run admin:create)
ADMIN_EMAIL=admin@greenhub.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Green Hub Admin

# Cloudinary image hosting (https://cloudinary.com/console > Dashboard > Account Details)
# Sign up free at https://cloudinary.com — then paste your values here:
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_API_SECRET_HERE

# Razorpay payments (test mode)
# Get test keys at https://dashboard.razorpay.com/app/keys (Mode: Test)
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# Email service (Forgot Password flow)
# EMAIL_TRANSPORT=smtp (production) or ethereal (local testing only — mails
# go to a throwaway Ethereal inbox; the API returns a preview link).
# For Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_USER=your@gmail.com,
# EMAIL_PASSWORD=<16-char App Password> (https://myaccount.google.com/apppasswords)
EMAIL_TRANSPORT=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Green Hub <noreply@greenhub.com>

# Email (password reset codes) — SMTP provider of your choice.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=465, EMAIL_SECURE=true,
# EMAIL_USER=you@gmail.com, EMAIL_PASSWORD=<16-char Gmail App Password>
# (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=Green Hub <no-reply@greenhub.com>

# LOCAL TESTING ONLY (never in production):
# EMAIL_TRANSPORT=ethereal  -> sends via a throwaway Ethereal test account
#                              and prints the message preview URL in the logs.
